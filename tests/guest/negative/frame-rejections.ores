// Runtime-negative oracle: every malformed frame must be rejected.
// Exact guest stdout: "db:wal-rejections-ok" (no trailing newline).
import module wal_frame from "../../../src/wal/frame";
pub routine main(): void {
  val List<int> key = new List<int>();
  val List<int> value = new List<int>();
  key.add(107); value.add(118);
  val good = wal_frame.encode(7, 3, 1, 42, 1, borrow! key, borrow! value);
  if good.is_err(); then stdio.stdout.write("db:FAILED"); return; fi
  val bytes = good.unwrap();

  val List<int> torn = new List<int>();
  val List<int> corrupted = new List<int>();
  val List<int> bad_kind = new List<int>();
  for (let i = 0; i < bytes.length; i++) {
    if i < bytes.length - 1; then torn.add(bytes.get(i)); fi
    if i == 26; then corrupted.add(108);
    else corrupted.add(bytes.get(i)); fi
    if i == 5; then bad_kind.add(3);
    else bad_kind.add(bytes.get(i)); fi
  }
  if !wal_frame.decode(borrow! torn).is_err() ||
    !wal_frame.decode(borrow! corrupted).is_err() ||
    !wal_frame.decode(borrow! bad_kind).is_err() ||
    !wal_frame.encode(0, 3, 1, 42, 1, borrow! key, borrow! value).is_err() ||
    !wal_frame.encode(7, 0, 1, 42, 1, borrow! key, borrow! value).is_err() ||
    !wal_frame.encode(7, 3, 0, 42, 1, borrow! key, borrow! value).is_err() ||
    !wal_frame.encode(7, 3, 1, 0, 1, borrow! key, borrow! value).is_err() ||
    !wal_frame.encode(7, 3, 1, 42, 2, borrow! key, borrow! value).is_err(); then
    stdio.stdout.write("db:FAILED"); return;
  fi
  val List<int> over_key = new List<int>();
  val List<int> over_value = new List<int>();
  for (let i = 0; i < 65; i++) { over_key.add(97); }
  for (let i = 0; i < 1025; i++) { over_value.add(98); }
  if !wal_frame.encode(7, 3, 1, 42, 1, borrow! over_key, borrow! value).is_err() ||
    !wal_frame.encode(7, 3, 1, 42, 1, borrow! key, borrow! over_value).is_err(); then
    stdio.stdout.write("db:FAILED"); return;
  fi
  stdio.stdout.write("db:wal-rejections-ok");
  return;
}
