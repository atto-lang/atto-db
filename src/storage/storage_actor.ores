// PROVISIONAL native .ores actor boundary. NOT executable evidence.
// Existing Java/LLVM source compilers have not yet demonstrated sealed-state
// lowering plus runtime-owned durable FD capabilities on this exact tree.
// Fail CLOSED until the runtime can inject an authenticated storage authority.
define isolated actor DbStorageActor as
  state {
    closed: bool = true;
  }

  // No user actor may submit an arbitrary filesystem path or FD as DATA.
  // This actor deliberately rejects every message; it never ACKs a write.
  // A future handler must authenticate source tenant, isolate and generation
  // before looking up runtime-owned append/sync/dirsync/rename operations.
  // Never suspend while an ephemeral handle_state critical loan is live.
  receive(ActorMail<int> mail): void {
    self.handle_state(critical-write |s| -> {
      s.closed = true;
    });
    self.end();
    return;
  }
end
